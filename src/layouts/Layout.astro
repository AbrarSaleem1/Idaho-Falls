---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  schemaType?: "LocalBusiness" | "Service" | "AboutPage" | "ContactPage" | "CollectionPage";
  serviceName?: string;
  areaServedName?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = "https://idahofallswaterheaterrepair.com/favicon.svg",
  schemaType = "LocalBusiness",
  serviceName,
  areaServedName = "Idaho Falls",
  breadcrumbs = [],
  faqs = []
} = Astro.props;

// Ensure clean trailing slash for canonical URL
const formattedPath = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = `https://idahofallswaterheaterrepair.com${formattedPath}`;

// Base Organization & LocalBusiness JSON-LD
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "PlumbingService",
  "name": "Idaho Falls Water Heater Pros",
  "image": "https://idahofallswaterheaterrepair.com/favicon.svg",
  "@id": "https://idahofallswaterheaterrepair.com/#organization",
  "url": "https://idahofallswaterheaterrepair.com/",
  "telephone": "+12082182108",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1265 Chaffin Ln",
    "addressLocality": "Idaho Falls",
    "addressRegion": "ID",
    "postalCode": "83401",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 43.498459,
    "longitude": -112.062089
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Idaho Falls" },
    { "@type": "City", "name": "Ammon" },
    { "@type": "AdministrativeArea", "name": "Bonneville County" }
  ]
};

// BreadcrumbList JSON-LD
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://idahofallswaterheaterrepair.com/"
    },
    ...breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": b.name,
      "item": b.url.startsWith("http") ? b.url : `https://idahofallswaterheaterrepair.com${b.url}`
    }))
  ]
} : null;

// FAQPage JSON-LD
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

// Service JSON-LD
const serviceSchema = serviceName ? {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": serviceName,
  "provider": {
    "@type": "PlumbingService",
    "name": "Idaho Falls Water Heater Pros"
  },
  "areaServed": {
    "@type": "City",
    "name": areaServedName
  },
  "description": description
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Idaho Falls Water Heater Pros" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Technical local SEO geo tags -->
    <meta name="geo.region" content="US-ID" />
    <meta name="geo.placename" content="Idaho Falls" />
    <meta name="geo.position" content="43.498459;-112.062089" />
    <meta name="ICBM" content="43.498459, -112.062089" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {serviceSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
