---
export interface Props {
  headline?: string;
  subtext?: string;
}

const {
  headline = "Have an Emergency Water Heater Leak or No Hot Water?",
  subtext = "Our certified technicians in Idaho Falls are ready 24/7. Call right now for immediate dispatch or to request an estimate."
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band-inner">
    <div class="cta-text">
      <h2 class="cta-headline">{headline}</h2>
      <p class="cta-subtext">{subtext}</p>
    </div>
    <div class="cta-buttons">
      <a href="tel:+12082182108" class="btn btn-primary cta-btn-call">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
        Call (208) 218-2108
      </a>
      <a href="/contact-us/" class="btn btn-white cta-btn-quote">
        Schedule Online
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    padding: 4rem 0;
    color: #ffffff;
  }

  .cta-band-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    text-align: center;
  }

  @media (min-width: 960px) {
    .cta-band-inner {
      flex-direction: row;
      text-align: left;
    }
  }

  .cta-text {
    max-width: 650px;
  }

  .cta-headline {
    color: #ffffff;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .cta-subtext {
    color: #cbd5e1;
    font-size: 1.05rem;
    margin-bottom: 0;
    line-height: 1.5;
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 380px;
    flex-shrink: 0;
  }

  @media (min-width: 500px) {
    .cta-buttons {
      flex-direction: row;
    }
  }

  .cta-btn-call, .cta-btn-quote {
    flex: 1;
    white-space: nowrap;
  }
</style>
