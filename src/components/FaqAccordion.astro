---
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  faqs: FaqItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs,
  title = "Frequently Asked Questions",
  subtitle = "Clear answers about water heater repair, replacement, and local code in Idaho Falls."
} = Astro.props;
---

<section class="section faq-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Got Questions?</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="faq-accordion-list">
      {faqs.map((faq, index) => (
        <div class="faq-item" data-faq-index={index}>
          <button type="button" class="faq-trigger" aria-expanded="false" id={`faq-btn-${index}`} aria-controls={`faq-content-${index}`}>
            <span class="faq-question-text">{faq.question}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-body" id={`faq-content-${index}`} role="region" aria-labelledby={`faq-btn-${index}`} hidden>
            <div class="faq-inner-text">
              <p>{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-accordion-list {
    max-width: 840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item.active {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-sm);
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    gap: 1rem;
    transition: background-color 0.15s ease;
  }

  .faq-trigger:hover {
    background-color: var(--color-bg-light);
  }

  .faq-icon {
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-accent);
    line-height: 1;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }

  .faq-body {
    padding: 0 1.5rem 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  .faq-inner-text {
    padding-top: 1rem;
  }

  .faq-inner-text p {
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }
</style>

<script>
  function setupFaqs() {
    const items = document.querySelectorAll('.faq-item');
    items.forEach((item) => {
      const btn = item.querySelector('.faq-trigger');
      const body = item.querySelector('.faq-body');
      if (!btn || !body) return;

      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        
        // Close other items in the same list
        items.forEach((other) => {
          if (other !== item) {
            other.classList.remove('active');
            const otherBtn = other.querySelector('.faq-trigger');
            const otherBody = other.querySelector('.faq-body');
            if (otherBtn && otherBody) {
              otherBtn.setAttribute('aria-expanded', 'false');
              otherBody.setAttribute('hidden', '');
            }
          }
        });

        if (isExpanded) {
          item.classList.remove('active');
          btn.setAttribute('aria-expanded', 'false');
          body.setAttribute('hidden', '');
        } else {
          item.classList.add('active');
          btn.setAttribute('aria-expanded', 'true');
          body.removeAttribute('hidden');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupFaqs);
</script>
