---
const currentPath = Astro.url.pathname;

const services = [
  { name: "Water Heater Repair", href: "/services/water-heater-repair/" },
  { name: "Water Heater Replacement", href: "/services/water-heater-replacement/" },
  { name: "Water Heater Maintenance", href: "/services/water-heater-maintenance/" },
  { name: "Water Heater Installation", href: "/services/water-heater-installation/" },
  { name: "Tankless Water Heater Repair and Installation", href: "/services/tankless-water-heater-repair-installation/" },
  { name: "Gas Water Heater Repair and Installation", href: "/services/gas-water-heater-repair-installation/" },
  { name: "Electric Water Heater Repair and Installation", href: "/services/electric-water-heater-repair-installation/" }
];

const neighborhoods = [
  { name: "Downtown Idaho Falls", href: "/locations/downtown-idaho-falls/" },
  { name: "Snake River Landing", href: "/locations/snake-river-landing/" },
  { name: "Kate Curley Park Area", href: "/locations/kate-curley-park/" },
  { name: "Ammon", href: "/locations/ammon/" },
  { name: "View All Service Areas →", href: "/locations/" }
];
---

<header class="site-header">
  <!-- Top Bar -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-info">
        <span class="badge-247">24/7 Emergency Service</span>
        <span class="top-address">📍 1265 Chaffin Ln, Idaho Falls, ID 83401</span>
      </div>
      <div class="top-cta">
        <a href="tel:+12082182108" class="top-phone">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
          <strong>(208) 218-2108</strong>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <div class="main-nav-wrap">
    <div class="container nav-inner">
      <a href="/" class="brand-logo" aria-label="Idaho Falls Water Heater Pros Home">
        <div class="logo-icon">
          <svg viewBox="0 0 64 64" fill="none" class="brand-svg">
            <path d="M32 4 C32 4 10 28 10 42 C10 53.05 19.85 62 32 62 C44.15 62 54 53.05 54 42 C54 28 32 4 32 4 Z" fill="#0b3b60"/>
            <path d="M32 56 C26 56 22 51.5 22 45.5 C22 39 27 34 32 26 C37 34 42 39 42 45.5 C42 51.5 38 56 32 56 Z" fill="#ea580c"/>
            <path d="M32 54 C28.5 54 26 50.8 26 47 C26 42.5 29.5 39 32 34 C34.5 39 38 42.5 38 47 C38 50.8 35.5 54 32 54 Z" fill="#facc15"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-title">Idaho Falls Water Heater Pros</span>
          <span class="brand-subtitle">Repair • Replacement • 24/7 Response</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          <li><a href="/" class={currentPath === "/" ? "active" : ""}>Home</a></li>
          
          <li class="has-dropdown">
            <a href="/services/" class={currentPath.startsWith("/services") ? "active dropdown-trigger" : "dropdown-trigger"}>
              Services <span class="caret">▾</span>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/services/" class="dropdown-hub">All Services Overview</a></li>
              {services.map((item) => (
                <li><a href={item.href}>{item.name}</a></li>
              ))}
            </ul>
          </li>

          <li class="has-dropdown">
            <a href="/locations/" class={currentPath.startsWith("/locations") ? "active dropdown-trigger" : "dropdown-trigger"}>
              Service Areas <span class="caret">▾</span>
            </a>
            <ul class="dropdown-menu">
              {neighborhoods.map((item) => (
                <li><a href={item.href}>{item.name}</a></li>
              ))}
            </ul>
          </li>

          <li><a href="/blog/" class={currentPath.startsWith("/blog") ? "active" : ""}>Blog</a></li>
          <li><a href="/about-us/" class={currentPath === "/about-us/" ? "active" : ""}>About Us</a></li>
          <li><a href="/contact-us/" class={currentPath === "/contact-us/" ? "active" : ""}>Contact Us</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="tel:+12082182108" class="btn btn-primary nav-cta">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
          Call (208) 218-2108
        </a>
        <button type="button" class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Toggle navigation menu" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="mobile-drawer-inner">
      <ul class="mobile-nav-list">
        <li><a href="/">Home</a></li>
        <li class="mobile-group-title">Services</li>
        <li><a href="/services/">All Services Hub</a></li>
        {services.map((item) => (
          <li><a href={item.href} class="mobile-sub-link">{item.name}</a></li>
        ))}
        <li class="mobile-group-title">Service Areas</li>
        <li><a href="/locations/">All 23 Neighborhoods Hub</a></li>
        {neighborhoods.map((item) => (
          <li><a href={item.href} class="mobile-sub-link">{item.name}</a></li>
        ))}
        <li class="mobile-group-title">Resources & Company</li>
        <li><a href="/blog/">Blog (20 Guides)</a></li>
        <li><a href="/about-us/">About Us</a></li>
        <li><a href="/contact-us/">Contact Us</a></li>
      </ul>
      <div class="mobile-drawer-cta">
        <a href="tel:+12082182108" class="btn btn-primary" style="width: 100%;">
          Call (208) 218-2108
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  .top-bar {
    background-color: var(--color-primary-dark);
    color: #ffffff;
    font-size: 0.88rem;
    padding: 0.5rem 0;
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .top-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .badge-247 {
    background-color: var(--color-accent);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .top-address {
    color: #cbd5e1;
  }

  .top-phone {
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
  }

  .top-phone:hover {
    color: #fed7aa;
  }

  .main-nav-wrap {
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .brand-title {
    display: block;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.15;
  }

  .brand-subtitle {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-list a {
    color: var(--color-text-main);
    font-weight: 600;
    font-size: 0.98rem;
    padding: 0.5rem 0.25rem;
    position: relative;
  }

  .nav-list a:hover, .nav-list a.active {
    color: var(--color-accent);
  }

  .has-dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .caret {
    font-size: 0.75rem;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    list-style: none;
    padding: 0.5rem 0;
    min-width: 280px;
    display: none;
    z-index: 100;
  }

  .dropdown-menu li a {
    display: block;
    padding: 0.55rem 1.25rem;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .dropdown-menu li a:hover {
    background-color: var(--color-bg-light);
    color: var(--color-accent);
  }

  .dropdown-hub {
    font-weight: 700 !important;
    border-bottom: 1px solid var(--color-border-light);
    color: var(--color-primary) !important;
  }

  .has-dropdown:hover .dropdown-menu {
    display: block;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-cta {
    padding: 0.65rem 1.25rem;
    font-size: 0.95rem;
    display: none;
  }

  @media (min-width: 640px) {
    .nav-cta {
      display: inline-flex;
    }
  }

  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 6px;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .mobile-menu-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-primary);
    transition: all 0.2s ease;
  }

  .mobile-drawer {
    display: none;
    background-color: #ffffff;
    border-bottom: 2px solid var(--color-accent);
    max-height: 80vh;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  .mobile-nav-list li a {
    display: block;
    padding: 0.65rem 0;
    color: var(--color-text-main);
    font-size: 1.05rem;
    font-weight: 600;
    border-bottom: 1px solid var(--color-border-light);
  }

  .mobile-group-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--color-text-light);
    letter-spacing: 0.05em;
    margin-top: 1rem;
    margin-bottom: 0.25rem;
    padding: 0;
  }

  .mobile-sub-link {
    padding-left: 1rem !important;
    font-size: 0.95rem !important;
    color: var(--color-text-muted) !important;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }
</script>
