---
export interface Props {
  variant?: "light" | "blue";
}

const { variant = "light" } = Astro.props;
---

<section class={`trust-strip ${variant === "blue" ? "trust-strip-blue" : ""}`}>
  <div class="container">
    <div class="trust-grid">
      <div class="trust-badge">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="badge-content">
          <strong>Licensed & Insured</strong>
          <span>Idaho Plumbing Code compliant</span>
        </div>
      </div>

      <div class="trust-badge">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="badge-content">
          <strong>24/7 Rapid Response</strong>
          <span>Emergency repairs in Bonneville County</span>
        </div>
      </div>

      <div class="trust-badge">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <div class="badge-content">
          <strong>Upfront Estimates</strong>
          <span>Call our office for an estimate</span>
        </div>
      </div>

      <div class="trust-badge">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="badge-content">
          <strong>100% Workmanship Guarantee</strong>
          <span>Quality parts & manufacturer warranties</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-strip {
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }

  .trust-strip-blue {
    background-color: var(--color-bg-subtle);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem;
  }

  .badge-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #eff6ff;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .badge-content strong {
    display: block;
    color: var(--color-primary-dark);
    font-size: 0.98rem;
    line-height: 1.2;
    margin-bottom: 0.2rem;
  }

  .badge-content span {
    display: block;
    color: var(--color-text-light);
    font-size: 0.82rem;
    line-height: 1.3;
  }
</style>
