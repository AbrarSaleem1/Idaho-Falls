---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactForm from '../../components/ContactForm.astro';

const pageTitle = "Gas Water Heater Repair & Installation Idaho Falls | 24/7";
const pageDescription = "Licensed gas water heater repair and replacement in Idaho Falls, ID. Experts in pilot lights, gas valves, power-vent tanks, and flue combustion safety.";

const breadcrumbs = [
  { name: "Services", url: "/services/" },
  { name: "Gas Water Heaters", url: "/services/gas-water-heater-repair-installation/" }
];

const faqs = [
  {
    question: "Why does my gas water heater pilot light keep blowing out?",
    answer: "The most common reason is a worn or dirty thermocouple. The thermocouple is a safety sensor that detects the pilot flame. If it becomes coated in soot or fails to generate sufficient millivoltage (typically 20-30 mV), the gas control valve automatically shuts off the gas supply for safety. Strong downdrafts down older masonry chimneys during Idaho Falls winter windstorms can also blow out weak pilots."
  },
  {
    question: "What is the difference between an atmospheric and a power-vent gas water heater?",
    answer: "Atmospheric units rely on natural gravity convection to vent hot exhaust gases up through a metal B-vent or chimney flue. Power-vent units feature an electric blower fan mounted on top of the tank that mechanically pushes exhaust gases horizontally through PVC pipe to an exterior wall. Power-vent units are ideal for homes without an existing chimney or where basements have tight draft clearances."
  },
  {
    question: "What should I do if I smell gas near my water heater?",
    answer: "If you detect a faint odor, check whether the pilot light has extinguished. However, if you smell a strong rotten-egg natural gas odor (mercaptan), do NOT flip any light switches or attempt to ignite anything. Evacuate your home immediately, leave the door open, call Intermountain Gas emergency response, and call our licensed technicians at (208) 218-2108 from a safe distance."
  },
  {
    question: "How long does a natural gas water heater last in Idaho Falls?",
    answer: "With our local 14.1 GPG hard water, an unmaintained gas water heater lasts approximately 6 to 9 years. High mineral scale concentrates on the bottom burner plate, causing the metal to overheat and fatigue. With regular annual flushes and anode rod checks, a premium gas tank can last 10 to 12 years."
  },
  {
    question: "Can you convert a natural gas water heater to propane (LP)?",
    answer: "Yes, certain models can be converted using a manufacturer-approved LP conversion kit that adjusts the burner orifice, pilot assembly, and regulator spring. However, many modern residential gas water heaters are factory-dedicated. We will inspect your system and verify whether conversion or a dedicated propane unit is required by local code."
  }
];

const relatedServices = [
  { name: "Water Heater Repair", url: "/services/water-heater-repair/" },
  { name: "Water Heater Replacement", url: "/services/water-heater-replacement/" },
  { name: "Tankless Water Heater Repair & Installation", url: "/services/tankless-water-heater-repair-installation/" },
  { name: "Water Heater Maintenance", url: "/services/water-heater-maintenance/" }
];
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/services/gas-water-heater-repair-installation/"
  breadcrumbs={breadcrumbs}
  serviceName="Gas Water Heater Repair and Installation"
  faqs={faqs}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="service-hero">
    <div class="container">
      <div class="service-hero-inner">
        <div class="service-hero-content">
          <span class="section-tag">Combustion Safety Specialists</span>
          <h1>Gas Water Heater Repair & Installation in Idaho Falls</h1>
          <p class="service-hero-lead">
            Natural gas water heaters provide rapid recovery and economical hot water for Idaho Falls households. However, gas systems require precise combustion adjustment, tight pipe fittings, and proper chimney draft to operate safely. Idaho Falls Water Heater Pros provides licensed gas water heater repair and installation in Idaho Falls with 24/7 emergency response and certified combustion safety testing.
          </p>
          <div class="service-hero-ctas">
            <a href="tel:+12082182108" class="btn btn-primary btn-lg">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
              Call (208) 218-2108
            </a>
            <a href="#contact" class="btn btn-outline btn-lg">
              Schedule Gas Inspection
            </a>
          </div>
          <p class="hero-availability-note">
            Serving homeowners across Idaho Falls, Ammon, and Bonneville County. Explore our <a href="/locations/">service locations</a>.
          </p>
        </div>

        <div class="service-hero-highlight">
          <div class="highlight-card">
            <img 
              src="/images/gas-water-heater-burner-repair-inspection.webp" 
              alt="Gas water heater burner inspection and draft testing in Idaho Falls" 
              width="450" 
              height="280" 
              class="service-feature-photo" 
            />
            <h3>Combustion Safety Experts</h3>
            <p class="promo-desc">Flue draft testing, gas control valve replacements, pilot assemblies, and power-vent diagnostics.</p>
            <a href="tel:+12082182108" class="btn btn-primary" style="width:100%;">
              Call for an Estimate: (208) 218-2108
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Scope -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Expert Capabilities</span>
        <h2>Our Gas Water Heater Services</h2>
        <p>Comprehensive troubleshooting and installation for natural gas and propane systems.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <h3>Thermocouple & Pilot Repair</h3>
          <p>We test millivolt electrical generation and replace faulty thermocouples, thermopiles, spark igniters, and pilot gas supply tubing safely.</p>
        </div>
        <div class="card">
          <h3>Gas Control Valve Diagnostics</h3>
          <p>When the main burner won't ignite or temperature knobs fail to regulate, we replace faulty Honeywell and White-Rodgers gas control valves.</p>
        </div>
        <div class="card">
          <h3>Flue Draft & Chimney Inspection</h3>
          <p>We test draft hood suction to verify exhaust fumes vent freely up the chimney, preventing deadly carbon monoxide backdrafting into your living space.</p>
        </div>
        <div class="card">
          <h3>Power-Vent Blower Repair</h3>
          <p>We test induction motor fans, pressure switches, and exhaust air proving switches on side-vented power-vent gas water heaters.</p>
        </div>
        <div class="card">
          <h3>Gas Line Fitting & Drip Legs</h3>
          <p>We install rigid black steel piping with code-required sediment traps (drip legs), manual shutoffs, and AGA-approved stainless gas flex connectors.</p>
        </div>
        <div class="card">
          <h3>New Gas Tank Replacements</h3>
          <p>We install high-efficiency Bradford White and Rheem gas storage tanks with self-cleaning dip tubes and factory-sealed combustion chambers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational: Combustion & Drafting in Idaho Winters -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Safety Engineering</span>
        <h2>Combustion & Drafting Dynamics in Idaho Falls</h2>
        <p>Why winter home air-sealing demands strict venting standards.</p>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3>The Danger of Winter Flue Backdrafting</h3>
          <p>
            During frigid Eastern Idaho winters, homes are sealed tightly to conserve heat. When bathroom exhaust fans, kitchen hoods, or clothes dryers run, they create negative air pressure inside the basement.
          </p>
          <p>
            If an atmospheric gas water heater's flue isn't drafting strongly, toxic exhaust gases—including odorless carbon monoxide—can be pulled back into the living area instead of rising up the chimney. Our technicians perform smoke tests and electronic draft measurements on every call.
          </p>
        </div>

        <div class="card">
          <h3>Bottom Plate Overheating from Scale</h3>
          <p>
            In a gas water heater, the burner flame shoots directly against the convex steel bottom of the tank. In Idaho Falls, a layer of hard calcium scale (14.1 GPG) forms right on top of that bottom plate.
          </p>
          <p>
            Instead of heat passing smoothly into the water, the steel is trapped between a 1,000°F flame and a layer of rock. This causes the bottom plate to overheat, warp, and crack prematurely. Regular maintenance is crucial to gas tank longevity.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Workflow</span>
        <h2>How We Service Gas Water Heaters</h2>
        <p>A methodical, safety-first protocol on every job.</p>
      </div>

      <div class="grid-4 process-grid">
        <div class="process-step">
          <div class="step-badge">1</div>
          <h3>Gas Sniff & Draft Test</h3>
          <p>We sweep the appliance perimeter with an electronic combustible gas detector and test flue draft velocity.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">2</div>
          <h3>Combustion Analysis</h3>
          <p>We examine the burner flame pattern to confirm a crisp blue flame without lazy yellow tipping or soot rollout.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">3</div>
          <h3>Component Repair</h3>
          <p>We replace the defective thermocouple, gas control valve, or burner assembly using factory-approved OEM components.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">4</div>
          <h3>Leak Check & Sign-Off</h3>
          <p>We test every pipe joint with non-corrosive leak detection solution, verify water temperature, and document all safety checks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Related Options</span>
        <h2>Other Hot Water Services</h2>
        <p>Explore tankless conversions and electric options.</p>
      </div>

      <div class="grid-4">
        {relatedServices.map((item) => (
          <div class="card">
            <h3>{item.name}</h3>
            <p>Reliable service options throughout Idaho Falls.</p>
            <a href={item.url} class="btn btn-outline" style="width:100%; text-align:center;">
              Learn More →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={faqs} title="Gas Water Heater FAQs" />

  <CtaBand 
    headline="Having Issues With Your Gas Water Heater?"
    subtext="Call (208) 218-2108 now. Our licensed gas technicians are available 24/7 across Idaho Falls and Ammon."
  />

  <ContactForm 
    title="Schedule Gas Water Heater Service"
    subtitle="Let us know your symptoms and we will dispatch a qualified gas technician."
    locationContext="Idaho Falls Gas Water Heater"
  />
</Layout>

<style>
  .service-hero {
    background: linear-gradient(180deg, #f0f7fc 0%, #ffffff 100%);
    padding: 3.5rem 0 4rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .service-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .service-hero-inner {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .service-hero-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .service-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .hero-availability-note {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  .hero-availability-note a {
    color: var(--color-primary);
    font-weight: 700;
  }

  .highlight-card {
    background: #ffffff;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .highlight-card h3 {
    font-size: 1.1rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .promo-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .promo-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .promo-code {
    display: inline-block;
    background-color: var(--color-bg-subtle);
    border: 1px dashed var(--color-primary);
    padding: 0.5rem 1.25rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    border-radius: var(--radius-sm);
    letter-spacing: 0.08em;
  }
</style>
