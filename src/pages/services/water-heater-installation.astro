---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactForm from '../../components/ContactForm.astro';

const pageTitle = "Water Heater Installation Idaho Falls | Code-Compliant Installs";
const pageDescription = "Expert water heater installation in Idaho Falls, ID for new construction, basement additions, and upgrades. Fully permitted with thermal expansion tanks and seismic straps.";

const breadcrumbs = [
  { name: "Services", url: "/services/" },
  { name: "Water Heater Installation", url: "/services/water-heater-installation/" }
];

const faqs = [
  {
    question: "How do you calculate the right water heater size for my Idaho Falls home?",
    answer: "We use First Hour Rating (FHR) calculations rather than simple tank gallon capacity alone. We factor in your household's peak morning or evening hot water demand—including simultaneous showers, dishwasher cycles, and washing machines—along with Idaho Falls' cold winter groundwater temperature (often 35°F to 40°F) to ensure your system recovers quickly without lukewarm spells."
  },
  {
    question: "What permits are required for a new water heater installation in Idaho Falls?",
    answer: "The City of Idaho Falls Building Division mandates a plumbing permit for any new water heater installation or major alteration. As an Idaho licensed plumbing contractor, Idaho Falls Water Heater Pros pulls all required municipal permits, verifies electrical and gas code compliance, and schedules the final city plumbing inspection."
  },
  {
    question: "Why is an expansion tank necessary on a new water heater installation?",
    answer: "Under Idaho State Plumbing Code, when water is heated inside a closed plumbing system (such as one with a backflow preventer or pressure-reducing valve), it expands in volume by roughly 2% to 3%. Without an expansion tank to cushion this thermal expansion, the extra water pressure stresses tank welds, damages pipe fittings, and can cause the T&P relief valve to dump water onto your floor."
  },
  {
    question: "Can you relocate my water heater during a basement finish or remodel?",
    answer: "Yes. During basement finishing or home remodels, we frequently relocate water heaters into dedicated mechanical rooms or utility closets. We re-route cold and hot water copper/PEX manifolds, extend gas supply lines or 240V circuits, and install code-compliant direct-vent or power-vent piping to an exterior wall."
  },
  {
    question: "What warranties come with a new water heater installation?",
    answer: "Our new Bradford White, Rheem, and AO Smith tank installations include standard 6 to 10-year manufacturer tank and parts warranties, along with our comprehensive 1-year local workmanship guarantee covering all labor, piping, and valve connections."
  }
];

const relatedServices = [
  { name: "Water Heater Replacement", url: "/services/water-heater-replacement/" },
  { name: "Tankless Water Heater Repair & Installation", url: "/services/tankless-water-heater-repair-installation/" },
  { name: "Gas Water Heater Repair & Installation", url: "/services/gas-water-heater-repair-installation/" },
  { name: "Electric Water Heater Repair & Installation", url: "/services/electric-water-heater-repair-installation/" }
];
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/services/water-heater-installation/"
  breadcrumbs={breadcrumbs}
  serviceName="Water Heater Installation"
  faqs={faqs}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="service-hero">
    <div class="container">
      <div class="service-hero-inner">
        <div class="service-hero-content">
          <span class="section-tag">New Builds & Upgrades</span>
          <h1>Water Heater Installation in Idaho Falls</h1>
          <p class="service-hero-lead">
            Whether you are building a new custom home, finishing a basement suite, or upgrading an undersized system, proper installation is the key to safety, comfort, and energy efficiency. Idaho Falls Water Heater Pros provides professional water heater installation in Idaho Falls with precise load sizing, full code compliance, and guaranteed city inspection sign-offs.
          </p>
          <div class="service-hero-ctas">
            <a href="tel:+12082182108" class="btn btn-primary btn-lg">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
              Call (208) 218-2108
            </a>
            <a href="tel:+12082182108" class="btn btn-outline btn-lg">
              Call for an Estimate
            </a>
          </div>
          <p class="hero-availability-note">
            Serving homeowners and general contractors throughout Bonneville County. Explore our <a href="/locations/">service locations</a>.
          </p>
        </div>

        <div class="service-hero-highlight">
          <div class="highlight-card">
            <img 
              src="/images/modern-residential-basement-mechanical-room.webp" 
              alt="Code-compliant water heater installation in Idaho Falls basement" 
              width="450" 
              height="280" 
              class="service-feature-photo" 
            />
            <h3>Code-Approved Installs</h3>
            <p class="promo-desc">Complete thermal expansion tank sizing, seismic safety straps, and city permit management.</p>
            <a href="tel:+12082182108" class="btn btn-primary" style="width:100%;">
              Call for an Estimate: (208) 218-2108
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Scope of Installation -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Complete Installation Service</span>
        <h2>What Our Installation Service Includes</h2>
        <p>A rigorous, code-approved approach to every hot water system installation.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <h3>Load & Sizing Engineering</h3>
          <p>We analyze bathroom fixtures, appliance demand, and incoming winter groundwater temperatures to calculate the exact gallon and BTU requirements for your home.</p>
        </div>
        <div class="card">
          <h3>Gas & Electrical Connections</h3>
          <p>We install rigid iron gas piping with dedicated drip legs and shutoffs, or hardwire 240V electrical circuits with proper gauge wiring and dedicated breakers.</p>
        </div>
        <div class="card">
          <h3>Venting & Combustion Air</h3>
          <p>We configure category-compliant venting—whether atmospheric B-vent through a roof stack or high-efficiency concentric PVC direct-venting through a sidewall.</p>
        </div>
        <div class="card">
          <h3>Thermal Expansion Control</h3>
          <p>We calculate dynamic pressure levels and install properly pre-charged thermal expansion tanks, mounted securely with independent structural support.</p>
        </div>
        <div class="card">
          <h3>Seismic Restraint Bracing</h3>
          <p>Every tank is secured with heavy-gauge steel earthquake straps bolted to wall framing to meet local Idaho structural safety regulations.</p>
        </div>
        <div class="card">
          <h3>Emergency Drain Pan & Shutoff</h3>
          <p>We install durable aluminum or composite drain pans piped to a safe gravity discharge point to protect finished basements from accidental water damage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational: Sizing & Siting -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Engineering Insights</span>
        <h2>Getting the Right Installation for Idaho Falls Winters</h2>
        <p>Why improper sizing causes cold showers in Eastern Idaho.</p>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3>The Groundwater Temperature Factor</h3>
          <p>
            In warmer southern states, groundwater enters homes at 65°F to 75°F. In Idaho Falls, winter groundwater temperatures frequently plunge below 40°F.
          </p>
          <p>
            This means your water heater must produce an 80°F to 85°F temperature rise. An undersized burner or element that works fine in summer will struggle in January, leaving your household waiting hours for water to reheat. We engineer every installation for peak winter performance.
          </p>
        </div>

        <div class="card">
          <h3>Closed-System Pressure Management</h3>
          <p>
            Most homes in Idaho Falls and Ammon operate on closed plumbing systems equipped with backflow preventers or pressure-reducing valves.
          </p>
          <p>
            When heated water expands, it has nowhere to go. Without a correctly sized thermal expansion tank, pressure inside your pipes can surge from 60 PSI to over 140 PSI, damaging washing machine solenoids, faucet cartridges, and shortening water heater lifespan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Installation Workflow -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Our Process</span>
        <h2>Step-by-Step Installation Process</h2>
        <p>From initial design to final city inspector approval.</p>
      </div>

      <div class="grid-4 process-grid">
        <div class="process-step">
          <div class="step-badge">1</div>
          <h3>Site Assessment</h3>
          <p>We inspect room clearances, combustion air supply, electrical panels, and water supply lines to verify installation suitability.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">2</div>
          <h3>Mechanical Fit-Up</h3>
          <p>We position the unit on an elevated base, mount the drain pan, and secure seismic straps directly into solid framing.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">3</div>
          <h3>Piping & Venting</h3>
          <p>We solder or crimp copper/PEX connections with dielectric unions, connect the expansion tank, and seal venting joints securely.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">4</div>
          <h3>Testing & Permitting</h3>
          <p>We conduct pressure tests, calibrate thermostats, inspect combustion draft, and file final paperwork with the city building division.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Connected Services</span>
        <h2>Related Water Heating Services</h2>
        <p>Find the exact solution you need for your home or property.</p>
      </div>

      <div class="grid-4">
        {relatedServices.map((item) => (
          <div class="card">
            <h3>{item.name}</h3>
            <p>Comprehensive options for homeowners across Idaho Falls.</p>
            <a href={item.url} class="btn btn-outline" style="width:100%; text-align:center;">
              Explore Service →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={faqs} title="Water Heater Installation FAQs" />

  <CtaBand 
    headline="Planning a Water Heater Installation in Idaho Falls?"
    subtext="Get honest advice, transparent pricing, and code-compliant craftsmanship. Call (208) 218-2108 to speak with our installation team today."
  />

  <ContactForm 
    title="Request An Installation Consultation"
    subtitle="Tell us about your project and we will provide an accurate upfront quote."
    locationContext="Idaho Falls Water Heater Installation"
  />
</Layout>

<style>
  .service-hero {
    background: linear-gradient(180deg, #f0f7fc 0%, #ffffff 100%);
    padding: 3.5rem 0 4rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .service-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .service-hero-inner {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .service-hero-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .service-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .hero-availability-note {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  .hero-availability-note a {
    color: var(--color-primary);
    font-weight: 700;
  }

  .highlight-card {
    background: #ffffff;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .highlight-card h3 {
    font-size: 1.1rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .promo-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .promo-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .promo-code {
    display: inline-block;
    background-color: var(--color-bg-subtle);
    border: 1px dashed var(--color-primary);
    padding: 0.5rem 1.25rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    border-radius: var(--radius-sm);
    letter-spacing: 0.08em;
  }
</style>
