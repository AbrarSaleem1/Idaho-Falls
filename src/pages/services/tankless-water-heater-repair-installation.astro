---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactForm from '../../components/ContactForm.astro';

const pageTitle = "Tankless Water Heater Repair & Installation Idaho Falls | 24/7";
const pageDescription = "Endless hot water with high-efficiency tankless water heaters in Idaho Falls. Certified Navien and Rinnai installation, repairs, and annual descaling.";

const breadcrumbs = [
  { name: "Services", url: "/services/" },
  { name: "Tankless Water Heaters", url: "/services/tankless-water-heater-repair-installation/" }
];

const faqs = [
  {
    question: "Do tankless water heaters work well in Idaho Falls during freezing winters?",
    answer: "Yes, provided they are sized correctly for Eastern Idaho's winter groundwater temperatures. In January, incoming water can drop below 40°F. Sizing a unit to achieve a 120°F output requires an 80°F rise. We install high-output units (up to 199,000 BTU) capable of delivering 4.5 to 6.0+ gallons per minute (GPM) even in sub-zero winter weather."
  },
  {
    question: "How often do tankless water heaters need to be descaled in Idaho Falls?",
    answer: "Because Idaho Falls water contains 14.1 GPG of calcium and magnesium hardness, tankless units must be flushed and descaled every 12 months. Without annual descaling, mineral scale blankets the compact heat exchanger fins, causing error codes, reduced water flow, and eventual heat exchanger failure."
  },
  {
    question: "What is required to switch from a tank water heater to a tankless unit?",
    answer: "A conversion typically involves three steps: upgrading the gas supply line to a dedicated 3/4-inch line (to feed the 160,000 to 199,000 BTU burner), installing direct-vent dual-pipe or concentric venting through an exterior wall, and installing a 120V electrical outlet for the unit's digital controls and internal freeze-protection heating ceramic."
  },
  {
    question: "What does the 'cold water sandwich' mean and how do you prevent it?",
    answer: "The 'cold water sandwich' effect happens when someone turns a shower off and quickly back on. A small slug of unheated water enters the line while the tankless burner fires up. We install modern tankless models with built-in internal buffer tanks and recirculation pumps (like Navien NPE-A2 series) to completely eliminate temperature fluctuations."
  },
  {
    question: "What brands of tankless water heaters do you service and install?",
    answer: "We are factory-trained on premier tankless brands including Navien, Rinnai, Noritz, Rheem, and Bosch. We carry replacement sensors, flame rods, igniters, and flow turbines directly on our service trucks."
  }
];

const relatedServices = [
  { name: "Water Heater Repair", url: "/services/water-heater-repair/" },
  { name: "Water Heater Replacement", url: "/services/water-heater-replacement/" },
  { name: "Gas Water Heater Repair & Installation", url: "/services/gas-water-heater-repair-installation/" },
  { name: "Water Heater Maintenance", url: "/services/water-heater-maintenance/" }
];
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/services/tankless-water-heater-repair-installation/"
  breadcrumbs={breadcrumbs}
  serviceName="Tankless Water Heater Repair and Installation"
  faqs={faqs}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="service-hero">
    <div class="container">
      <div class="service-hero-inner">
        <div class="service-hero-content">
          <span class="section-tag">Endless Hot Water</span>
          <h1>Tankless Water Heater Repair & Installation in Idaho Falls</h1>
          <p class="service-hero-lead">
            Enjoy unlimited hot water, lower utility bills, and reclaim up to 16 square feet of basement floor space with modern on-demand water heating. Idaho Falls Water Heater Pros provides expert tankless water heater repair and installation in Idaho Falls. From brand-new retrofits to annual hard water descaling flushes, our certified technicians keep your unit performing at peak efficiency.
          </p>
          <div class="service-hero-ctas">
            <a href="tel:+12082182108" class="btn btn-primary btn-lg">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
              Call (208) 218-2108
            </a>
            <a href="#contact" class="btn btn-outline btn-lg">
              Request Tankless Quote
            </a>
          </div>
          <p class="hero-availability-note">
            Available throughout Idaho Falls, Snake River Landing, and Ammon. Explore all <a href="/locations/">service areas</a>.
          </p>
        </div>

        <div class="service-hero-highlight">
          <div class="highlight-card">
            <img 
              src="/images/tankless-water-heater-installation-wall-mount.webp" 
              alt="High efficiency tankless water heater installation on wall" 
              width="450" 
              height="280" 
              class="service-feature-photo" 
            />
            <h3>Endless Hot Water Upgrades</h3>
            <p class="promo-desc">Navien and Rinnai certified conversions, dedicated 3/4-inch gas line upgrades, and annual descaling service.</p>
            <a href="tel:+12082182108" class="btn btn-primary" style="width:100%;">
              Call for an Estimate: (208) 218-2108
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Scope -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Full-Spectrum Service</span>
        <h2>Our Tankless Capabilities</h2>
        <p>Specialized engineering for high-demand on-demand hot water equipment.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <h3>Tank-to-Tankless Conversions</h3>
          <p>We replace bulky storage cylinders with sleek, wall-hung units, upgrading gas supply lines, venting penetrations, and condensate drain lines to code.</p>
        </div>
        <div class="card">
          <h3>Annual Heat Exchanger Descaling</h3>
          <p>Using recirculating descaling pump kits and food-grade virgin citric solution, we dissolve calcium buildup inside narrow heat exchanger waterways.</p>
        </div>
        <div class="card">
          <h3>Digital Error Code Diagnostics</h3>
          <p>We decipher manufacturer error codes (such as ignition failure, flame loss, fan motor faults, or scale detection) and replace genuine OEM sensors on site.</p>
        </div>
        <div class="card">
          <h3>Gas Line & Pressure Verification</h3>
          <p>Tankless systems demand high gas volume. We verify supply line diameters and test dynamic operating pressure to prevent flame dropouts under heavy demand.</p>
        </div>
        <div class="card">
          <h3>Freeze-Protection & Venting</h3>
          <p>We install dedicated exterior termination caps with backdraft dampers and check built-in freeze protection ceramic heating elements for Idaho winters.</p>
        </div>
        <div class="card">
          <h3>Recirculation Loop Integration</h3>
          <p>We program built-in recirculation pumps to deliver instant hot water to distant second-story bathrooms without wasting gallons down the drain.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hard Water and Sizing Deep Dive -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Engineering Factors</span>
        <h2>Tankless Sizing & Hard Water Protection in Idaho Falls</h2>
        <p>Two essential technical considerations for reliable long-term performance.</p>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3>Combating Idaho Falls' 14.1 GPG Scale</h3>
          <p>
            In a tankless water heater, water is flashed to 120°F inside tiny copper or stainless steel coils in seconds. This rapid heating causes calcium carbonate from our local Eastern Snake River Plain water to crystallize almost instantly.
          </p>
          <p>
            Without annual maintenance, this scale insulates the heat exchanger, triggering overheat error codes and eventual thermal cracking. We install service isolation valves on every unit so routine annual flushes are quick, clean, and painless.
          </p>
        </div>

        <div class="card">
          <h3>Winter Flow Rate (GPM) Calculation</h3>
          <p>
            Tankless flow capacity (gallons per minute) depends directly on incoming water temperature. When Idaho Falls groundwater is 38°F, a 199,000 BTU unit can produce roughly 4.8 GPM of 120°F water—enough to run two simultaneous high-flow showers comfortably.
          </p>
          <p>
            We never under-size units. Our calculations ensure your family has robust, uninterrupted hot water even on the coldest January mornings.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Installation Roadmap</span>
        <h2>How We Install Your Tankless System</h2>
        <p>A seamless, code-compliant conversion in a single day.</p>
      </div>

      <div class="grid-4 process-grid">
        <div class="process-step">
          <div class="step-badge">1</div>
          <h3>Gas & Vent Audit</h3>
          <p>We calculate total home gas appliance load to ensure your meter and gas lines can supply up to 199,000 BTU without starving your furnace.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">2</div>
          <h3>Wall Mount & Clearances</h3>
          <p>We secure a structural mounting bracket to wood studs or masonry, ensuring proper combustible clearance on all sides.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">3</div>
          <h3>Direct-Vent Routing</h3>
          <p>We core-drill an exterior wall penetration and install schedule 40 PVC, CPVC, or polypropylene concentric venting to code.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">4</div>
          <h3>Combustion Testing</h3>
          <p>We connect digital gas manometers, check combustion CO/CO2 ratios, calibrate temperature settings, and verify freeze protection.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Related Options</span>
        <h2>Other Hot Water Solutions</h2>
        <p>Explore traditional tanks and alternative configurations.</p>
      </div>

      <div class="grid-4">
        {relatedServices.map((item) => (
          <div class="card">
            <h3>{item.name}</h3>
            <p>Reliable options for Idaho Falls homeowners.</p>
            <a href={item.url} class="btn btn-outline" style="width:100%; text-align:center;">
              Explore Service →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={faqs} title="Tankless Water Heater FAQs" />

  <CtaBand 
    headline="Interested in Endless Hot Water?"
    subtext="Call (208) 218-2108 today to discuss tankless options and request an estimate in Idaho Falls or Ammon."
  />

  <ContactForm 
    title="Schedule A Tankless Consultation"
    subtitle="Let us know your household size and current water heater setup for an accurate proposal."
    locationContext="Idaho Falls Tankless Water Heater"
  />
</Layout>

<style>
  .service-hero {
    background: linear-gradient(180deg, #f0f7fc 0%, #ffffff 100%);
    padding: 3.5rem 0 4rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .service-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .service-hero-inner {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .service-hero-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .service-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .hero-availability-note {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  .hero-availability-note a {
    color: var(--color-primary);
    font-weight: 700;
  }

  .highlight-card {
    background: #ffffff;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .highlight-card h3 {
    font-size: 1.1rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .promo-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .promo-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .promo-code {
    display: inline-block;
    background-color: var(--color-bg-subtle);
    border: 1px dashed var(--color-primary);
    padding: 0.5rem 1.25rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    border-radius: var(--radius-sm);
    letter-spacing: 0.08em;
  }
</style>
