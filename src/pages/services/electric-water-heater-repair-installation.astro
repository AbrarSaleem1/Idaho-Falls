---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactForm from '../../components/ContactForm.astro';

const pageTitle = "Electric Water Heater Repair & Installation Idaho Falls | 24/7";
const pageDescription = "Licensed electric water heater repair and installation in Idaho Falls, ID. Experts in element burnout, thermostat replacements, 240V circuits, and hybrid heat pumps.";

const breadcrumbs = [
  { name: "Services", url: "/services/" },
  { name: "Electric Water Heaters", url: "/services/electric-water-heater-repair-installation/" }
];

const faqs = [
  {
    question: "Why does the red reset button on my electric water heater keep tripping?",
    answer: "The red button on the upper thermostat is the Emergency Cut-Off (ECO) high-limit switch. It automatically trips when water temperature exceeds 170°F to prevent scalding and tank rupture. This is almost always caused by a shorted heating element or a stuck thermostat switch that keeps heating continuously. If the button trips more than once, call a licensed technician to test the electrical circuits."
  },
  {
    question: "Why did my electric water heater suddenly stop producing hot water?",
    answer: "Check your main electrical panel first to see if the dedicated 30-amp 240V double-pole breaker has tripped. If the breaker is on, the failure is usually a burnt-out upper heating element or a tripped ECO high-limit switch. In standard dual-element water heaters, power goes to the upper element first; if that element fails, the unit cannot heat water at all."
  },
  {
    question: "How does Idaho Falls hard water destroy electric heating elements?",
    answer: "Our local groundwater contains roughly 14.1 GPG of calcium carbonate. As the element heats to high temperatures, calcium crystals rapidly precipitate onto the metal sheath, forming a thick crust of limescale. This crust traps heat inside the element wire, preventing it from transferring into the water until the internal resistance coil overheats and melts."
  },
  {
    question: "What are resistored low-watt-density heating elements?",
    answer: "Standard heating elements concentrate intense electrical heat over a short surface area. Low-watt-density elements spread the same heating wattage over a longer, folded tube, operating at lower surface temperatures. This drastically slows down limescale accumulation and extends element life significantly in Idaho Falls hard water."
  },
  {
    question: "Are hybrid heat pump electric water heaters a good option in Idaho Falls?",
    answer: "Yes, hybrid heat pump water heaters consume up to 70% less electricity than standard resistance models by pulling ambient heat from your basement air. However, because Eastern Idaho basements can get cold in winter, the unit must be installed in an unconfined room with adequate air volume or ducted properly. We help you choose the right model to qualify for local utility rebates."
  }
];

const relatedServices = [
  { name: "Water Heater Repair", url: "/services/water-heater-repair/" },
  { name: "Water Heater Replacement", url: "/services/water-heater-replacement/" },
  { name: "Water Heater Maintenance", url: "/services/water-heater-maintenance/" },
  { name: "Tankless Water Heater Repair & Installation", url: "/services/tankless-water-heater-repair-installation/" }
];
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/services/electric-water-heater-repair-installation/"
  breadcrumbs={breadcrumbs}
  serviceName="Electric Water Heater Repair and Installation"
  faqs={faqs}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="service-hero">
    <div class="container">
      <div class="service-hero-inner">
        <div class="service-hero-content">
          <span class="section-tag">240V Electrical Plumbing</span>
          <h1>Electric Water Heater Repair & Installation in Idaho Falls</h1>
          <p class="service-hero-lead">
            Electric water heaters are clean, safe, and dependable, but they face relentless mineral scaling from Idaho Falls' 14.1 GPG hard water. When elements burn out, high-limit switches trip, or tanks leak, Idaho Falls Water Heater Pros provides licensed electric water heater repair and installation in Idaho Falls with same-day element changeouts, precision thermostat calibrations, and 24/7 emergency service.
          </p>
          <div class="service-hero-ctas">
            <a href="tel:+12082182108" class="btn btn-primary btn-lg">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/></svg>
              Call (208) 218-2108
            </a>
            <a href="#contact" class="btn btn-outline btn-lg">
              Schedule Electric Repair
            </a>
          </div>
          <p class="hero-availability-note">
            Serving homes across Bonneville County. Explore our full <a href="/locations/">service area directory</a>.
          </p>
        </div>

        <div class="service-hero-highlight">
          <div class="highlight-card">
            <img 
              src="/images/electric-water-heater-heating-element-testing.webp" 
              alt="Testing electric heating elements with multimeter in Idaho Falls" 
              width="450" 
              height="280" 
              class="service-feature-photo" 
            />
            <h3>240V Electrical Specialists</h3>
            <p class="promo-desc">Dual low-watt density element replacements, thermostat calibrations, high-limit ECO resets, and wiring checks.</p>
            <a href="tel:+12082182108" class="btn btn-primary" style="width:100%;">
              Call for an Estimate: (208) 218-2108
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- Scope -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">240V Diagnostics</span>
        <h2>Our Electric Water Heater Capabilities</h2>
        <p>Comprehensive electrical and mechanical repairs for all major residential brands.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <h3>Dual Element Replacement</h3>
          <p>We test ohms and replace failed upper and lower elements with premium incoloy or copper-sheathed low-watt density elements that resist calcium scaling.</p>
        </div>
        <div class="card">
          <h3>Thermostat & ECO Switch Repair</h3>
          <p>We replace malfunctioning upper primary and lower secondary thermostats, recalibrating temperature limits to prevent dangerous overheating and nuisance tripping.</p>
        </div>
        <div class="card">
          <h3>Circuit & Breaker Diagnostics</h3>
          <p>We test incoming line voltage (240V L1/L2), check grounding connections, and verify wire gauge integrity to ensure electrical code compliance.</p>
        </div>
        <div class="card">
          <h3>Thermal Expansion Tanks</h3>
          <p>We mount and calibrate code-required thermal expansion tanks to protect electric tank cylinders from hydrostatic pressure stress.</p>
        </div>
        <div class="card">
          <h3>Emergency Leak Repairs</h3>
          <p>We repair leaking element screw threads, replace faulty drain valves, and service leaking cold and hot copper transition dielectric unions.</p>
        </div>
        <div class="card">
          <h3>Hybrid Heat Pump Upgrades</h3>
          <p>We install ultra-efficient hybrid heat pump water heaters (Rheem ProTerra, Bradford White AeroTherm) that slash electrical consumption by up to 70%.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hard Water and Element Failure -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Technical Grounding</span>
        <h2>Why Electric Elements Burn Out in Idaho Falls</h2>
        <p>How Eastern Idaho water chemistry causes premature electrical failures.</p>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3>Calcium Scaling & Element Overheating</h3>
          <p>
            An electric water heater element operates by running high electrical current through a Nichrome resistance wire packed inside magnesium oxide powder. The outer metal sheath heats to several hundred degrees.
          </p>
          <p>
            In Idaho Falls water (14.1 GPG), dissolved calcium carbonate attaches to that hot sheath. As the layer grows thicker, it acts as a thermal barrier. The element gets hotter and hotter inside until the internal wire melts, causing a complete break in the circuit.
          </p>
        </div>

        <div class="card">
          <h3>The 'Dry Fire' Danger</h3>
          <p>
            If power is turned back on before an electric water heater is 100% full of water, the upper element will burn out in under 30 seconds—a phenomenon called 'dry firing.'
          </p>
          <p>
            Our technicians always follow strict fill-and-purge procedures, bleeding all air from household hot water faucets before energizing electrical breakers to ensure your new elements last.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Our Workflow</span>
        <h2>Step-by-Step Electrical Repair Process</h2>
        <p>Safe, methodical electrical troubleshooting.</p>
      </div>

      <div class="grid-4 process-grid">
        <div class="process-step">
          <div class="step-badge">1</div>
          <h3>Voltage Lockout</h3>
          <p>We shut off the dedicated breaker and verify zero voltage at the terminal screws using a certified non-contact voltage tester and multimeter.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">2</div>
          <h3>Resistance Testing</h3>
          <p>We isolate the element terminals and test resistance in ohms. A standard 4500W element should measure 12.8 ohms; 0 ohms or infinity confirms failure.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">3</div>
          <h3>Clean Extraction</h3>
          <p>We drain the tank below the element level and extract the calcified element using heavy-duty hex sockets without damaging tank threads.</p>
        </div>
        <div class="process-step">
          <div class="step-badge">4</div>
          <h3>Fill, Bleed & Energize</h3>
          <p>We install new gaskets, refill the tank completely, purge all air bubbles from faucets, restore power, and verify proper amperage draw.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Related Options</span>
        <h2>Other Hot Water Solutions</h2>
        <p>Explore gas and tankless options for your home.</p>
      </div>

      <div class="grid-4">
        {relatedServices.map((item) => (
          <div class="card">
            <h3>{item.name}</h3>
            <p>Reliable service options throughout Idaho Falls.</p>
            <a href={item.url} class="btn btn-outline" style="width:100%; text-align:center;">
              Learn More →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion faqs={faqs} title="Electric Water Heater FAQs" />

  <CtaBand 
    headline="Electric Water Heater Tripping or Cold?"
    subtext="Call (208) 218-2108 now. Our licensed technicians carry premium replacement elements and thermostats for immediate 24/7 repair."
  />

  <ContactForm 
    title="Schedule Electric Water Heater Repair"
    subtitle="Call (208) 218-2108 directly to speak with an on-call technician and request an estimate."
    locationContext="Idaho Falls Electric Water Heater"
  />
</Layout>

<style>
  .service-hero {
    background: linear-gradient(180deg, #f0f7fc 0%, #ffffff 100%);
    padding: 3.5rem 0 4rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .service-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .service-hero-inner {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .service-hero-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .service-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .hero-availability-note {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  .hero-availability-note a {
    color: var(--color-primary);
    font-weight: 700;
  }

  .highlight-card {
    background: #ffffff;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .highlight-card h3 {
    font-size: 1.1rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .promo-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .promo-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .promo-code {
    display: inline-block;
    background-color: var(--color-bg-subtle);
    border: 1px dashed var(--color-primary);
    padding: 0.5rem 1.25rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    border-radius: var(--radius-sm);
    letter-spacing: 0.08em;
  }
</style>
