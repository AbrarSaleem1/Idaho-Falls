---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactForm from '../components/ContactForm.astro';

const pageTitle = "Contact Idaho Falls Water Heater Pros | 24/7 Dispatch";
const pageDescription = "Contact Idaho Falls Water Heater Pros. 24/7 emergency dispatch and fast scheduling for water heater repairs and installations in Bonneville County. Call (208) 218-2108.";

const breadcrumbs = [
  { name: "Contact Us", url: "/contact-us/" }
];

const contactFaqs = [
  {
    question: "Do you really answer the phone 24 hours a day?",
    answer: "Yes. When you call (208) 218-2108, your call is answered live by our local dispatch team—not an out-of-state call center. We have licensed plumbers on call throughout the night, on weekends, and during major holidays for emergencies."
  },
  {
    question: "How quickly can a technician get to my home in Idaho Falls?",
    answer: "For emergency leaks, burner outages, or flooding threats, our typical arrival time across Idaho Falls and Ammon is between 45 and 90 minutes. For scheduled repairs or routine replacements, we offer tight two-hour appointment windows."
  },
  {
    question: "How do estimates work for water heater services?",
    answer: "We provide upfront written estimates for all water heater repairs, replacements, and tankless conversions in our Bonneville County service area. Call our office at (208) 218-2108 to speak with a technician and request an estimate."
  }
];
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/contact-us/"
  breadcrumbs={breadcrumbs}
  schemaType="ContactPage"
  faqs={contactFaqs}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Section -->
  <section class="contact-hero">
    <div class="container">
      <span class="section-tag">24/7 Local Dispatch</span>
      <h1>Contact Idaho Falls Water Heater Pros</h1>
      <p class="contact-hero-lead">
        Whether you are facing an emergency water heater leak or planning a high-efficiency replacement, we are here to help. Reach out by phone for immediate dispatch or submit an online request below.
      </p>
    </div>
  </section>

  <TrustStrip />

  <!-- Main Contact Information & Form -->
  <ContactForm 
    title="Send a Service Request" 
    subtitle="Our dispatch team responds promptly to all inquiries."
    locationContext="Contact Us Page"
  />

  <!-- Service Area Note -->
  <section class="section section-alt">
    <div class="container">
      <div class="service-area-callout">
        <h3>Comprehensive Bonneville County Service Coverage</h3>
        <p>
          Our mobile service fleet operates throughout Idaho Falls, Ammon, and surrounding zip codes: 
          <strong>83401, 83402, 83403, 83404, 83405, 83406, and 83415</strong>. 
          Explore our dedicated <a href="/locations/">neighborhood service directories</a> for local plumbing guides.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick FAQs -->
  <FaqAccordion faqs={contactFaqs} title="Pre-Service Questions" />

  <!-- CTA Band -->
  <CtaBand 
    headline="Water Heater Leaking Right Now?"
    subtext="Don't wait for basement damage to spread. Call our on-call Idaho Falls plumber at (208) 218-2108 for immediate 24/7 dispatch."
  />
</Layout>

<style>
  .contact-hero {
    background: linear-gradient(180deg, #f0f7fc 0%, #ffffff 100%);
    padding: 3.5rem 0 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--color-border-light);
  }

  .contact-hero h1 {
    margin-bottom: 1rem;
  }

  .contact-hero-lead {
    max-width: 780px;
    margin: 0 auto;
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  .service-area-callout {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    max-width: 840px;
    margin: 0 auto;
    border-left: 4px solid var(--color-primary);
  }

  .service-area-callout h3 {
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
  }

  .service-area-callout p {
    font-size: 1rem;
    margin-bottom: 0;
  }

  .service-area-callout a {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
