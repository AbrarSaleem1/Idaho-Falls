                <td>Pre-tank spin-down sediment filter</td>
              </tr>
              <tr>
                <td><strong>Anode Rod Type</strong></td>
                <td>Standard magnesium</td>
                <td>Powered titanium (eliminates sulfur odor)</td>
              </tr>
              <tr>
                <td><strong>Drain Valve Type</strong></td>
                <td>Standard valve</td>
                <td>Full-port brass ball valve for heavy flushes</td>
              </tr>
              <tr>
                <td><strong>Fuel Configuration</strong></td>
                <td>Standard Natural Gas</td>
                <td>Propane (LP) or High-Efficiency Electric</td>
              </tr>
            </tbody>
