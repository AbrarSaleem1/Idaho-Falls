                <th>Feature</th>
                <th>Atmospheric Gas Tank</th>
                <th>Electric Storage Tank</th>
                <th>Direct-Vent Tankless</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Energy Source</strong></td>
                <td>Natural Gas</td>
                <td>240V Electricity</td>
                <td>Natural Gas</td>
              </tr>
              <tr>
                <td><strong>First-Hour Rating</strong></td>
                <td>Fast recovery (70-80 gal)</td>
                <td>Moderate recovery (50-60 gal)</td>
                <td>Continuous flow (limitless)</td>
              </tr>
              <tr>
                <td><strong>Sediment Vulnerability</strong></td>
                <td>Moderate (bottom flushes)</td>
                <td>High (element burnout)</td>
                <td>Requires annual descaling</td>
              </tr>
              <tr>
                <td><strong>Ideal Placement</strong></td>
