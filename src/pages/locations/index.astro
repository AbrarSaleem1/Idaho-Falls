    desc: "Installing spin-down sand filters, powered titanium anode rods to stop sulfur odors, and LP propane water heater servicing.",
    streets: "New Sweden Hwy, W 33rd S, Milligan Rd, Great Feeder Canal Area, S 45th W"
  },
  {
    name: "Osgood",
    slug: "osgood",
    highlight: "Rural Farmsteads & Propane (LP) Heating Systems",
    desc: "Heavy mineral well scale management, propane burner orifice cleaning, and wind-resistant chimney vent terminations.",
    streets: "Osgood Rd, W 65th N, Sage Canal Rd, Old Butte Rd N, N 35th W"
  },
  {
    name: "Lincoln",
    slug: "lincoln",
