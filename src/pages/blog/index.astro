---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactForm from '../../components/ContactForm.astro';

const pageTitle = "Idaho Falls Water Heater Blog | Expert Guides & Local Advice";
const pageDescription = "Explore 20 comprehensive homeowner guides on water heater repair, replacement, hard water maintenance, troubleshooting, and plumbing codes in Idaho Falls.";

const breadcrumbs = [
