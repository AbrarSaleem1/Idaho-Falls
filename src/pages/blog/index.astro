---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalPath="/blog/"
  breadcrumbs={breadcrumbs}
  schemaType="CollectionPage"
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Section -->
  <section class="blog-hero">
    <div class="container">
      <span class="section-tag">Homeowner Education</span>
      <h1>Idaho Falls Water Heater Knowledge Base</h1>
      <p class="blog-hero-lead">
        20 in-depth plumbing guides written by local technicians who understand the water chemistry, winter weather, and building codes of Idaho Falls and Bonneville County.
      </p>
    </div>
  </section>

  <TrustStrip />

  <!-- Blog Posts Grid -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">All 20 Knowledge Guides</span>
        <h2>Troubleshooting, Maintenance, Sizing & Plumbing Codes</h2>
        <p>Explore our complete library of expert guides to protect your water heater, solve emergencies, and maximize energy efficiency.</p>
      </div>

      <div class="grid-2 blog-grid">
        {blogPosts.map((post) => (
          <article class="card blog-card">
            <div class="blog-meta">
              <span class="blog-category">{post.category}</span>
              <span class="blog-date">{post.date}</span>
            </div>
            <h3>
              <a href={post.url} class="blog-title-link">{post.title}</a>
            </h3>
            <p class="blog-excerpt">{post.excerpt}</p>
            <div class="blog-card-footer">
              <span class="blog-author">By {post.author}</span>
              <a href={post.url} class="read-more-link">Read Full Guide →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <CtaBand 
    headline="Have a Water Heater Question or Need Immediate Service?"
    subtext="Call (208) 218-2108 now to speak directly with an on-call licensed plumber in Idaho Falls and request an estimate."
  />

  <!-- Contact Section (Pure Phone CTA) -->
  <ContactForm 
    title="Schedule Your Diagnostic or Maintenance Call" 
    subtitle="Call (208) 218-2108 directly to discuss your system with an on-call technician and request an estimate."
    locationContext="All Idaho Falls & Bonneville County Zip Codes"
  />
</Layout>

<style>
  .blog-hero {
    background: linear-gradient(180deg, #f0f7fc 0%, #ffffff 100%);
    padding: 3.5rem 0 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--color-border-light);
  }

  .blog-hero h1 {
    max-width: 850px;
    margin: 0 auto 1.25rem auto;
    font-size: clamp(2rem, 4vw, 2.7rem);
  }

  .blog-hero-lead {
    max-width: 750px;
    margin: 0 auto;
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .blog-grid {
    margin-top: 2rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .blog-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
  }

  .blog-category {
    color: var(--color-secondary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(234, 88, 12, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .blog-date {
    color: var(--color-text-muted);
  }

  .blog-card h3 {
    font-size: 1.25rem;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .blog-title-link {
    color: var(--color-text-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-title-link:hover {
    color: var(--color-primary);
  }

  .blog-excerpt {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .blog-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border-light);
    padding-top: 0.85rem;
    margin-top: auto;
    font-size: 0.9rem;
  }

  .blog-author {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .read-more-link {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .read-more-link:hover {
    color: var(--color-secondary);
  }
</style>
