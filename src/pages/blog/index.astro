  {
    title: "Relocating a Water Heater During a Basement Finish or Remodel in Idaho Falls",
    slug: "relocating-water-heater-basement-remodel",
    category: "Remodeling",
    date: "July 14, 2026",
    author: "Remodel Project Lead",
    excerpt: "Planning a basement finish or remodel in Idaho Falls? Learn plumbing codes, drain pan rules, combustion air, gas line routing, and tankless relocation.",
    url: "/blog/relocating-water-heater-basement-remodel/"
  },
  {
    title: "What to Do Immediately When Your Water Heater Bursts and Floods Your Basement",
    slug: "emergency-water-heater-flooding-steps",
    category: "Emergency Safety",
    date: "July 10, 2026",
    author: "Emergency Response Tech",
    excerpt: "Water heater leaking or bursting in Idaho Falls? Follow these 5 immediate emergency steps to stop flooding, prevent electrical hazards, and minimize damage.",
    url: "/blog/emergency-water-heater-flooding-steps/"
  },
  {
    title: "Gas Line Sizing for Tankless Water Heaters: Upgrading from 1/2-Inch to 3/4-Inch Pipe",
